# ==============================================================================
# RMSTORVIX IGNITE — Invoice & Billing SaaS Environment Template
# Copy to .env locally for development, or configure in Vercel Environment Variables.
# NEVER commit real secrets or production credentials to GitHub.
# ==============================================================================

# --- Application & Runtime ---
APP_NAME="RMSTORVIX Invoice & Billing System"
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000

# --- Frontend, API Routing & CORS ---
# Production primary origin (e.g. https://your-project.vercel.app or https://app.yourdomain.com)
FRONTEND_URL=
# Comma-separated authorized origins merged with CORS_ORIGINS
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Optional split-origin backend API base URL for frontend (blank = same-origin /api/v1)
API_BASE_URL=

# --- Database: Supabase PostgreSQL (Primary Production Connection) ---
# Recommended for Vercel Serverless: Supabase Connection Pooler (Transaction mode :6543 or Session mode :5432)
# Example: postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Local PostgreSQL fallback fields (used only when DATABASE_URL is empty)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=invoice_billing
POSTGRES_USER=invoice_app
POSTGRES_PASSWORD=change_me_local_only

# Serverless & Connection Pooling Tuning (auto-detected for Vercel & pooler endpoints)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_SECONDS=8
DB_USE_NULLPOOL=
DB_SSL_REQUIRE=
DB_DISABLE_PREPARED_STATEMENTS=

# --- Persistent Media & PDF Storage (Supabase Storage in Production) ---
# auto = Supabase Storage when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set; local = local disk
STORAGE_BACKEND=auto
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=rmstorvix-private
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_SIGNED_URL_TTL=300

# Local dev fallback directories (not persistent on Vercel; /tmp used automatically on serverless)
STORAGE_PDF_DIR=storage/pdfs
STORAGE_SIGNATURE_DIR=storage/signatures
SIGNATURE_MAX_BYTES=2097152
STORAGE_LOGO_DIR=storage/logos
LOGO_MAX_BYTES=2097152

# --- Security & Signing Secrets ---
JWT_SECRET_KEY=replace_with_32_plus_char_random_secret
SESSION_COOKIE_NAME=inv_session
SESSION_TTL_HOURS=24
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Separate Admin Panel Credentials & Session (Never exposed to frontend) ---
ADMIN_SESSION_COOKIE_NAME=rmx_admin_session
ADMIN_SESSION_TTL_HOURS=12
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME="RMSTORVIX Administrator"

# --- External GST Verification & Mail Configuration (Optional) ---
GSTIN_API_URL=
GST_VERIFICATION_API_KEY=
GSTIN_API_KEY=
GSTIN_API_TIMEOUT_SECONDS=6
MAIL_CONFIGURATION=

# --- SaaS Subscription & Activation Code Policy ---
SUPPORT_EMAIL=support@rmstorvix.com
SUPPORT_PHONE=+91-1800-000-0000
ENFORCE_SUBSCRIPTION_EXPIRY=true
ALLOW_SELF_ACTIVATION=true
NOTIFICATION_INTERVALS_DAYS=30,15,7,3,1,0
ACTIVATION_RATE_LIMIT_MAX_ATTEMPTS=8
ACTIVATION_RATE_LIMIT_WINDOW_MINUTES=15
